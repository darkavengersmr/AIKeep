# PostgreSQL connection string (local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aikeep?schema=public"

# Separate database for unit tests (vitest). Falls back to DATABASE_URL if unset.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aikeep_test?schema=public"

# Bootstrap admin user (prisma db seed)
ADMIN_EMAIL="admin@aikeep.dev"
ADMIN_PASSWORD="change-me-in-prod"
ADMIN_DISPLAY_NAME="Admin"

# Dev invite code (prisma db seed). Empty to skip creating one.
INVITE_CODE="AIKEEP-DEV-2026"
INVITE_MAX_USES=""